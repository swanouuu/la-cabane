  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Gribbs",
        Texts:[{Text:"Psst ! Toi ! Tu veux une montre ? … J'ai pas de montre. Mais si t'en veux une, je peux t'en trouver une."},{Text:"Mouloud, c'est mon cousin. Enfin, cousin… on a le même oncle. Enfin, oncle… c'est un voisin."},{Text:"Je vends des secrets. Premier secret gratuit : Macron a peur des poules."},{Text:"Si un garde te demande, tu m'as jamais vu. Si Mouloud te demande, je suis très beau."}],
