	quest.6B09984DCFEFAC34.quest_desc: [
		"Le petit village est devenu une ville. Les habitants vous saluent enfin dans la rue."
		""
		"Même Gérard. Même Vegeta (de loin)."
	]
	quest.6B09984DCFEFAC34.title: "&6&lBeauvais, capitale de la jungle"
