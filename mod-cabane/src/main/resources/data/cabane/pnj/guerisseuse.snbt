  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Nyota",
        Texts:[{Text:"Assieds-toi près du feu, voyageur. Ici on raconte les histoires des donjons lointains… et de ceux qui n'en sont jamais revenus."},{Text:"Une feuille de jungle sur une coupure, et ça repart. Sur une jambe cassée, c'est plus compliqué."},{Text:"Le Président m'a demandé une tisane pour le courage. Je lui ai donné de l'eau chaude. Ça a marché."},{Text:"Dors dans un lit avant de partir loin : sinon tu repars de l'avion. Et l'avion brûle."}],
        Buttons:[{
          Label:"bye",
          Name:"Merci Nyota",
          Type:"CLOSE"
        }]
      }]
  },
  Status:{finalized:1b}
}
