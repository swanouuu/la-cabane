  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Vegeta",
        Texts:[{Text:"Il est là. Je le sens… Kakarot. Allez chercher tout le monde. TOUT le monde."},{Text:"Ma capsule s'est écrasée ici en le poursuivant. Aujourd'hui, il vient à moi. Réunissez-vous autour de moi, et parlez-moi."},{Text:"Vous tremblez ? Normal. Ce qui va se passer dans le ciel de Beauvais, personne ne l'a jamais vu."}],
