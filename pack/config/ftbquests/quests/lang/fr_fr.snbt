	quest.73A740F15D08ECBE.title: "L'Acropole"
	quest.753BE5C735570076.quest_desc: [
		"À 10 000 blocs plein sud se dresse la Forteresse du Sud, le repaire des Pillards. Au cœur du donjon : la Salle Zéro."
		""
		"Tapez &e/cabane forteresse&r pour ses coordonnées. Pour l'instant elle est scellée : c'est pour plus tard ! L'hôte l'ouvrira quand le moment sera venu."
		""
		"Allez la voir de vos yeux, puis cochez."
	]
	quest.753BE5C735570076.quest_subtitle: "Acte V — Le repaire"
