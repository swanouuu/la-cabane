  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Accueil",
        Texts:[{Text:"Vous avez vu ça ? Votre avion a pris feu au-dessus de la savane ! Le village accepte de vous héberger dans la Grande Cabane… à condition de l'aider."}],
        Buttons:[{
          Label:"aider",
          Name:"Comment aider ?",
          Type:"ACTION",
          Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"aider"}]
        },{
          Label:"reliques",
          Name:"Et cette cabane ?",
          Type:"ACTION",
          Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"reliques"}]
        },{
          Label:"bye",
          Name:"À plus tard",
          Type:"CLOSE"
        }]
      },{
        Label:"aider",
        Name:"Aider le village",
        Texts:[{Text:"Bako, au marché, a des contrats qui changent toutes les heures : apportez-lui ce qu'il demande, il paie en SakaiDollars. Et regardez le tableau des quêtes, à côté de la cabane."}],
        Buttons:[{
          Label:"bye",
          Name:"On s'y met !",
          Type:"CLOSE"
        }]
      },{
        Label:"reliques",
        Name:"Les Sept Reliques",
        Texts:[{Text:"Sept reliques reposaient sur le comptoir. Elles ont été cachées dans les plus grands donjons du monde, parfois très loin d'ici. Ramenez-les, et la Cabane se réveillera. Tout est noté dans votre livre de quêtes."}],
        Buttons:[{
          Label:"cartes",
          Name:"Comment les trouver ?",
          Type:"ACTION",
          Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"cartes"}]
        },{
          Label:"bye",
          Name:"J'y vais !",
          Type:"CLOSE"
        }]
      },{
        Label:"cartes",
        Name:"Les cartes",
        Texts:[{Text:"Mira, la cartographe, vous guidera : chaque quête d'indice vous donne une carte au trésor. Prenez des provisions… et vos téléphones."}],
        Buttons:[{
          Label:"bye",
          Name:"Merci, Gardien",
          Type:"CLOSE"
        }]
      }]
  },
  Status:{finalized:1b}
