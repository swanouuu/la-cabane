  ActionData:{ActionEventSet:{ON_INTERACTION:[{Type:"OPEN_DEFAULT_DIALOG"}]}},
  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Garde",
        Texts:[{Text:"Halte, voyageur ! … Ah, tu viens de l'avion en feu. Entre : le Hejj t'attend devant la Grande Cabane."},{Text:"Rien à signaler. Sauf un singe qui m'a volé mon casque hier. Si tu le vois, il s'appelle Bernard. Pas l'habitant, le singe."},{Text:"Je garde cette porte depuis dix ans. Personne n'a jamais essayé d'entrer par le mur. Heureusement."},{Text:"Le soir, on entend des choses dans la jungle. Le plus souvent c'est Gérard qui ronfle."}],
        Buttons:[{
          Label:"bye",
          Name:"Merci !",
          Type:"CLOSE"
        }]
      }]
  },
  Status:{finalized:1b}
}
