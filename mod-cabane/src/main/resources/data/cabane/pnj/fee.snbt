        },{
          Label:"bye",
          Name:"Merci Ovsie !",
          Type:"CLOSE"
        }]
      },{
        Label:"casino",
        Name:"Le casino",
        Texts:[{Text:"Roulette, roue de la fortune, blackjack… Mouloud vend les tables : à vous de construire le plus beau casino de la jungle ! Le gérant remplit la caisse, accroupi + clic droit."}],
