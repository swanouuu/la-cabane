  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Pierre",
        Texts:[{Text:"Libre ! Je respire enfin l'air de la jungle. Merci, les gens du ciel. Marcel n'arrête pas de raconter votre combat."},{Text:"Le Conseil des Anciens va se réunir à nouveau. Et cette fois, c'est vous qu'on écoutera."},{Text:"Je suis allé voir l'ancien président dans ma vieille cellule. Il m'a demandé un référendum. J'ai refusé."}],
