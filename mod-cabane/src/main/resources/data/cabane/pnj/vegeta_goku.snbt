    DialogDataSet:[{
        Label:"default",
        Name:"Vegeta",
        Texts:[{Text:"Le M de Babidi a disparu. Ne vous faites pas d'idées : je ne vous dois rien. … Merci."},{Text:"Kakarot est reparti s'entraîner. Il a dit que Beauvais était « un super coin pour pique-niquer ». Idiot."},{Text:"Si vous racontez à quelqu'un que vous m'avez sauvé, je fais exploser votre maison. Gentiment."}],
