	quest.76B1F2887A20E368.quest_desc: [
		"Karim veut une carte des environs dessinée par toi. « Chouf, on verra si tu sais tenir une boussole. »"
	]
	quest.76B1F2887A20E368.title: "Une carte pour Karim"
	quest.7884DA74F6956A35.quest_desc: [
		"Les villageois regardent les gens du ciel de travers. Parlez à trois d'entre eux : chacun a une histoire de raid ou de disparition à raconter."
		""
		"Jean, Monique, Thierry, Ginette… choisissez. Puis cochez."
	]
	quest.7884DA74F6956A35.title: "Ceux qui se méfient"
	quest.788DD4E54A6A6223.quest_desc: [
