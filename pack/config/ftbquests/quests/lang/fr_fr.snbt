{
	chapter.0F76A38B1018536B.title: "&2Agrandir Beauvais"
	chapter.16AB2FF51EB0851E.title: "&6&lL'Histoire de Beauvais"
	chapter.44CD4C5260BE1635.title: "&eLes Sept Reliques"
	chapter.74547F9A4ABCA689.title: "&bLes gens de Beauvais"
	chapter.775508E513569867.title: "&aLe Village"
	chapter.7849F1A38AA6D284.title: "&cLes Grands Donjons"
	chapter.7DF581286AE72B3C.title: "&6Beauvais"
	quest.01CBF0BA670EB442.quest_desc: [
		"Au feu de camp, un vieil homme fume la pipe et regarde le ciel. C'est &6Marcel le Conteur&r : il connaît l'histoire de Beauvais mieux que personne."
		""
		"Écoutez-le jusqu'au bout (jusqu'à la prophétie), puis cochez cette quête."
	]
	quest.01CBF0BA670EB442.quest_subtitle: "Acte I — Les gens du ciel"
	quest.01CBF0BA670EB442.title: "&6Marcel le Conteur"
	quest.03F6D4DFAA073670.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.03F6D4DFAA073670.title: "Le Palais de Shiraz"
	quest.04572A8ED20384A1.quest_desc: [
		"« Une ville moderne, c'est un rond-point. » — Macron, Président de Beauvais."
		""
		"Construisez un rond-point fleuri à l'entrée du quartier neuf, puis cochez cette quête."
	]
	quest.04572A8ED20384A1.quest_subtitle: "C'est notre projet !"
	quest.04572A8ED20384A1.title: "Le rond-point du Président"
	quest.070F6BEE2B0A62E3.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.070F6BEE2B0A62E3.title: "&cLe Gardien de l'End"
	quest.08D5B1720E4DEAD6.quest_desc: [
		"Un vrai port, avec un ponton et des bateaux. Thierry dit que c'est « une preuve ». Thierry a raison."
		""
		"Construisez le port, puis cochez cette quête."
	]
	quest.08D5B1720E4DEAD6.title: "Le port"
	quest.0981060BFF9B3A80.quest_desc: [
		"Monique veut tout noter. Absolument tout. Un livre et une plume, vite."
	]
	quest.0981060BFF9B3A80.title: "Les potins de Monique"
	quest.0C4DD23C76CDC05A.quest_desc: [
		"Pour une fois, ton dossier sera complet. Mehdi demande : du papier, une étiquette et une horloge (« pour la ponctualité »)."
	]
	quest.0C4DD23C76CDC05A.title: "Le dossier complet"
	quest.0C5B8DC2684CD88F.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.0C5B8DC2684CD88F.title: "L'Usine Ancienne"
	quest.0D3F2FBF63AD6E94.quest_desc: [
		"Les Vindicateurs sont les gros bras des Pillards. Ils frappent fort. Frappez plus fort."
	]
	quest.0D3F2FBF63AD6E94.title: "Les brutes à la hache"
	quest.0DC04F56329BC588.quest_desc: [
		"Trouvez un avant-poste des Pillards. Dans leurs coffres, de l'or… frappé du sceau de la Mairie ?"
		""
		"Comment des pillards peuvent-ils être payés par le Président ? Il faudra fouiller la Mairie."
	]
	quest.0DC04F56329BC588.title: "L'avant-poste"
	quest.0ED2F75EB32984DE.quest_desc: [
		"Le Président veut une statue. En or. « Petite, mais en or. »"
		"Livrez l'or, construisez la statue sur la place du quartier neuf, puis cochez cette quête."
	]
	quest.0ED2F75EB32984DE.title: "La statue du Président"
	quest.118C2DEDB64B2488.quest_desc: [
		"Les charpentiers du village ont besoin de bois. Beaucoup de bois."
	]
	quest.118C2DEDB64B2488.title: "Des planches pour le quartier neuf"
	quest.12B120B96D758D92.quest_desc: [
		"Dans la Salle Zéro, utilisez la Clé sur le pupitre. Le Président se réveillera, fusionné avec sa machine."
		""
		"Il est très, très fort. Venez tous ensemble, avec vos meilleures armes, des potions, des totems. Et ne lâchez rien."
	]
	quest.12B120B96D758D92.quest_subtitle: "Le Président Augmenté"
	quest.12B120B96D758D92.title: "&6&lLibérer Beauvais"
	quest.1313B185449CA3E3.quest_desc: [
		"Vestige des fonderies et des citadelles mécaniques."
		""
		"Coche cette quête pour recevoir une &6carte au trésor&r. Elle mène à un donjon à environ 7000 blocs de la cabane. Prévoyez le voyage !"
	]
	quest.1313B185449CA3E3.title: "Indice : Fonderies Oubliées"
	quest.138C1D24FD05722C.quest_desc: [
		"Grosh a « un peu » mangé le charbon de la forge. Brokk est furieux. Remplace-le vite."
	]
	quest.138C1D24FD05722C.title: "Le charbon de Grosh"
	quest.1452DDA22E67B185.quest_desc: [
		"Entre dans le donjon. Méfie-toi, ses gardiens ne t'attendent pas les bras ouverts."
	]
	quest.1452DDA22E67B185.title: "Trouver : Temple de la Jungle"
	quest.157CE27E91E64AE3.quest_desc: [
		"Scellé dans la salle du trésor d'une forteresse enfouie."
		""
		"Ramène-la à la Cabane et pose-la sur un cadre du &6mur des reliques&r."
	]
	quest.157CE27E91E64AE3.title: "&6Œil du Gardien"
	quest.161721A13AF5F233.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.161721A13AF5F233.title: "La Flèche du Nécromancien"
	quest.161DB3E801CC763B.quest_desc: [
		"« Ici, faut faire ses preuves. » Thierry veut que tu nettoies la jungle des zombies."
	]
	quest.161DB3E801CC763B.title: "Faire ses preuves"
	quest.171408FDF42922B0.quest_desc: [
		"Les villageois ont faim : apporte 32 pains."
	]
	quest.171408FDF42922B0.title: "Nourrir le village"
	quest.178AE12232445145.quest_desc: [
		"Gardée au plus profond d'un temple englouti par la jungle."
		""
		"Coche cette quête pour recevoir une &6carte au trésor&r. Elle mène à un donjon à environ 4000 blocs de la cabane. Prévoyez le voyage !"
	]
	quest.178AE12232445145.title: "Indice : Temple de la Jungle"
	quest.183DCC1F588D2578.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.183DCC1F588D2578.title: "&cLe Sculpteur"
	quest.1974F56FFD803CBD.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.1974F56FFD803CBD.title: "Le Donjon de Kayra"
	quest.1ABE8225987936FB.quest_desc: [
		"Entre dans le donjon. Méfie-toi, ses gardiens ne t'attendent pas les bras ouverts."
	]
	quest.1ABE8225987936FB.title: "Trouver : Forteresses Illageoises"
	quest.1B1A5FCCDEFCE572.quest_desc: [
		"Avec les Pillards qui rôdent, Beauvais a besoin d'une vraie police (et pas de la garde du Président)."
		""
		"Livrez les matériaux, puis construisez un commissariat dans le quartier neuf : un bureau, une cellule, un parking pour la voiture. Cochez quand c'est fini."
	]
	quest.1B1A5FCCDEFCE572.quest_subtitle: "Une vraie police pour Beauvais"
	quest.1B1A5FCCDEFCE572.title: "Le commissariat"
	quest.1B47B0E50BBD7040.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.1B47B0E50BBD7040.title: "Le Labyrinthe"
	quest.1D49D9D2B5C40024.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.1D49D9D2B5C40024.title: "&cLe Wroughtnaut"
	quest.1E02703E34C70F9F.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.1E02703E34C70F9F.title: "&cLe Léviathan"
	quest.1E4DAB441F609283.quest_desc: [
		"Louis regarde les nuages toute la journée. Avec une longue-vue, il les verrait de plus près."
	]
	quest.1E4DAB441F609283.title: "Les nuages de Louis"
	quest.1FD30F90AE282C8F.quest_desc: [
		"Cachée dans les forteresses qui flottent au-dessus des nuages."
		""
		"Ramène-la à la Cabane et pose-la sur un cadre du &6mur des reliques&r."
	]
	quest.1FD30F90AE282C8F.title: "&6Plume Céleste"
	quest.218D1602B8B42AE0.quest_desc: [
		"Les fontaines de la place n'ont jamais marché. Thierry s'en plaint depuis dix ans."
		"Construisez une belle fontaine avec de l'eau qui coule dans le quartier neuf."
	]
	quest.218D1602B8B42AE0.title: "Une fontaine qui marche"
	quest.23ABBB9F0B1999B1.quest_desc: [
		"Create permet de construire des machines, des moulins, des trains…"
		"Fabrique 16 alliages d'andésite pour commencer."
	]
	quest.23ABBB9F0B1999B1.title: "Les rouages"
	quest.241FDFC2883E4E5A.quest_desc: [
		"Procure-toi un classeur : il range toutes tes cartes à collectionner."
	]
	quest.241FDFC2883E4E5A.title: "Collectionneur"
	quest.24B3EA48F5667552.quest_desc: [
		"Ginette veut ouvrir une école « pour que les jeunes arrêtent de faire des bêtises ». Il faut des livres."
	]
	quest.24B3EA48F5667552.title: "L'école de Ginette"
	quest.25273E17EBD095AA.quest_desc: [
		"Gérard réclame un bar. Le Hejj aussi, discrètement. Un comptoir, des tonneaux, une terrasse… et de quoi remplir les verres."
		""
		"Livrez les tonneaux et les premières bières (des blondes, à brasser ou à acheter chez Mouloud), construisez la taverne, puis cochez."
		""
		"Ensuite, vendez vos boissons : le marché rachète bières, vin et sodas dans ses contrats, et vos étals feront le reste."
	]
	quest.25273E17EBD095AA.quest_subtitle: "Pour fêter les retours d'expédition"
	quest.25273E17EBD095AA.title: "La taverne"
	quest.27216312CFC8D389.quest_desc: [
		"Les Pillards rôdent dans la jungle et brûlent les récoltes. Montrez-leur que Beauvais a de nouveaux protecteurs."
	]
	quest.27216312CFC8D389.quest_subtitle: "Acte II — Ceux qui viennent des marais"
	quest.27216312CFC8D389.title: "Les Pillards du Sud"
	quest.2851541B37712639.quest_desc: [
		"Ginette trouve que tout le monde est trop maigre. Elle prépare une soupe géante."
	]
	quest.2851541B37712639.title: "Mange une carotte"
	quest.2BC7B019F689DA68.quest_desc: [
		"La nuit, on entend des machines sous la Mairie. Dans le bureau du Président, une des bibliothèques sonne creux…"
		""
		"Trouvez le passage secret, et descendez."
	]
	quest.2BC7B019F689DA68.quest_subtitle: "Acte III — Ce qu'on entend sous la terre"
	quest.2BC7B019F689DA68.title: "La Mairie fermée la nuit"
	quest.2BD3FBE527316C9F.quest_desc: [
		"Les raids viennent toujours du sud. Une muraille autour du quartier neuf, avec une porte qui ferme, et les Pillards n'auront qu'à bien se tenir."
		""
		"Livrez les pierres, construisez les remparts, puis cochez."
	]
	quest.2BD3FBE527316C9F.quest_subtitle: "Contre les raids du sud"
	quest.2BD3FBE527316C9F.title: "Les remparts"
	quest.2DC0C447D1E4AB1D.quest_desc: [
		"Appuie sur &eN&r (ou clic droit avec le téléphone) et choisis ton numéro à 3 ou 4 chiffres."
		""
		"Le numéro est gravé dans le téléphone : il ne changera plus. Donne-le à tes potes… ou garde-le secret ! Puis appelle quelqu'un : la voix passe par Simple Voice Chat, où que vous soyez sur la map."
		""
		"Perdu ton téléphone ? Mouloud en vend au Grand Bazar."
	]
	quest.2DC0C447D1E4AB1D.quest_subtitle: "Ton numéro perso"
	quest.2DC0C447D1E4AB1D.title: "Allô ?"
	quest.30546597D6492C6A.quest_desc: [
		"Entre dans le donjon. Méfie-toi, ses gardiens ne t'attendent pas les bras ouverts."
	]
	quest.30546597D6492C6A.title: "Trouver : Fonderies Oubliées"
	quest.3171F4C0D66FBE1B.quest_desc: [
		"Des pierres taillées pour les fondations, les murs et les routes."
	]
	quest.3171F4C0D66FBE1B.title: "La carrière"
	quest.33B200AA18D79663.quest_desc: [
		"Entre dans le donjon. Méfie-toi, ses gardiens ne t'attendent pas les bras ouverts."
	]
	quest.33B200AA18D79663.title: "Trouver : Temple du Désert"
	quest.389EAB4D73BEB741.quest_desc: [
		"Le Président veut un pont « jusqu'à la lune ». Le Hejj propose de commencer par la rivière."
		""
		"Livrez les pierres, construisez un vrai pont sur la rivière la plus proche, puis cochez cette quête."
	]
	quest.389EAB4D73BEB741.title: "Le pont de la rivière"
	quest.397C706B2F73B8B6.quest_desc: [
		"Fabrique une marmite (Farmer's Delight). Les bons plats nourrissent beaucoup plus longtemps."
	]
	quest.397C706B2F73B8B6.title: "Aux fourneaux"
	quest.3A6BE1D1755F30ED.quest_desc: [
		"Bernard (l'habitant) cherche de quoi nourrir Bernard (le singe). Le singe adore les baies."
	]
	quest.3A6BE1D1755F30ED.title: "Le singe de Bernard"
	quest.3AAF104E2F5E2BEB.quest_desc: [
		"« Ton niveau de puissance est ridicule. Va combattre cinquante monstres, et on en reparlera. Hmph. »"
	]
	quest.3AAF104E2F5E2BEB.quest_subtitle: "L'entraînement du prince"
	quest.3AAF104E2F5E2BEB.title: "&9Ma stupide fierté"
	quest.3B258B2628A0EE6F.quest_desc: [
		"Achète un étal à la boutique et pose-le au marché : les autres pourront acheter ce que tu vends."
	]
	quest.3B258B2628A0EE6F.title: "Une place au marché"
	quest.3B3D0695C73A80A5.quest_desc: [
		"Nyota prépare des remèdes pour les explorateurs qui partent loin."
	]
	quest.3B3D0695C73A80A5.title: "Les remèdes de Nyota"
	quest.3BE3E5007AAA200A.quest_desc: [
		"Beauvais est libre. Pierre a retrouvé le feu de camp, et le Conseil des Anciens se réunit à nouveau."
		""
		"Allez écouter Pierre, puis rendez une petite visite à l'ancien président, dans sa cellule sous la Mairie. Il a sûrement une consultation citoyenne à vous proposer."
	]
	quest.3BE3E5007AAA200A.quest_subtitle: "Épilogue"
	quest.3BE3E5007AAA200A.title: "Le Conseil des Anciens"
	quest.3CC4A709D08884FC.quest_desc: [
		"Martine veut que tu dises à Vegeta, près de la tour de guet, que sa coiffure est ridicule."
		"Va lui parler (à tes risques), puis coche la quête."
	]
	quest.3CC4A709D08884FC.title: "Message pour Vegeta"
	quest.3DD5D5059BE6D774.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.3DD5D5059BE6D774.title: "La Cité Engloutie"
	quest.3E245369C09E7B82.quest_desc: [
		"Cachée dans les forteresses qui flottent au-dessus des nuages."
		""
		"Coche cette quête pour recevoir une &6carte au trésor&r. Elle mène à un donjon à environ 6000 blocs de la cabane. Prévoyez le voyage !"
	]
	quest.3E245369C09E7B82.title: "Indice : Citadelles du Ciel"
	quest.401F3F3D38522062.quest_desc: [
		"La map est immense. Fabrique une &bWaystone&r et pose-la près du village : vous pourrez y revenir de très loin."
	]
	quest.401F3F3D38522062.title: "Pierres de voyage"
	quest.4040726D0528310B.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.4040726D0528310B.title: "&cLe Héraut"
	quest.41AAB9DFC7CC4D19.quest_desc: [
		"Mouloud rêve d'un marché couvert, avec des toiles de toutes les couleurs. Mouloud rêve beaucoup."
	]
	quest.41AAB9DFC7CC4D19.title: "Le marché couvert"
	quest.44EDE10E469B20B0.quest_desc: [
		"Trouvé dans le tombeau du Pharaon, au cœur d'un temple du désert."
		""
		"Coche cette quête pour recevoir une &6carte au trésor&r. Elle mène à un donjon à environ 3500 blocs de la cabane. Prévoyez le voyage !"
	]
	quest.44EDE10E469B20B0.title: "Indice : Temple du Désert"
	quest.45A9B3AB9BA55F7F.quest_desc: [
		"Gardée au plus profond d'un temple englouti par la jungle."
		""
		"Ramène-la à la Cabane et pose-la sur un cadre du &6mur des reliques&r."
	]
	quest.45A9B3AB9BA55F7F.title: "&6Idole de Jade"
	quest.46E951E0C9BD2820.quest_desc: [
		"« Le cœur du village appartient aux habitants. Vous, installez-vous juste à côté, hors de l'enceinte. Et aidez Beauvais à pousser jusqu'à vous. »"
		""
		"Chaque chantier de ce chapitre agrandit le village : livrez les matériaux (ils sont pris), construisez, et le village vous paie."
		""
		"Construisez vos maisons à l'extérieur de l'enceinte, et faites grandir Beauvais vers elles !"
	]
	quest.46E951E0C9BD2820.quest_subtitle: "Faire grandir le village"
	quest.46E951E0C9BD2820.title: "&6Le grand plan du Hejj"
	quest.47A5313EBBF149FA.quest_desc: [
		"Le Président se tient sur la place, entouré de sa garde masquée. Allez le saluer. Souriez : il sourit beaucoup, lui aussi."
		""
		"Retenez bien ce qu'il dit. Et ce qu'il ne dit pas. Puis cochez."
	]
	quest.47A5313EBBF149FA.title: "Monsieur le Président"
	quest.47A7652B7F5C287E.quest_desc: [
		"« Du travail ? Je traverse la rue et je vous en trouve ! » Le Président veut que tu remplisses trois contrats de Mehdi."
		"Fais-le, puis coche la quête."
	]
	quest.47A7652B7F5C287E.quest_subtitle: "pour trouver du travail"
	quest.47A7652B7F5C287E.title: "Traverser la rue"
	quest.482CB649D83791DA.quest_desc: [
		"Construisez trois vraies maisons juste à côté du village, hors de l'enceinte : c'est le début du quartier neuf."
		""
		"Montrez-les au Hejj, puis cochez cette quête."
	]
	quest.482CB649D83791DA.quest_subtitle: "Trois maisons hors de l'enceinte"
	quest.482CB649D83791DA.title: "Le quartier neuf"
	quest.48F2088D4FD8A8BD.quest_desc: [
		"Elle repose dans un monument au fond de l'océan."
		""
		"Ramène-la à la Cabane et pose-la sur un cadre du &6mur des reliques&r."
	]
	quest.48F2088D4FD8A8BD.title: "&6Perle des Abysses"
	quest.49A7BD08274ACF97.quest_desc: [
		"Entre dans le donjon. Méfie-toi, ses gardiens ne t'attendent pas les bras ouverts."
	]
	quest.49A7BD08274ACF97.title: "Trouver : Monument des Profondeurs"
	quest.4D25A24F8001BCB4.quest_desc: [
		"Un jour, les Pillards du Sud marcheront sur le village (c'est l'hôte qui décide quand !). Ce jour-là, soyez prêts."
		""
		"Repoussez-les tous, protégez les habitants, puis cochez cette quête."
	]
	quest.4D25A24F8001BCB4.quest_subtitle: "Quand ils attaqueront…"
	quest.4D25A24F8001BCB4.title: "&cDéfendre Beauvais"
	quest.4EB5D2C754679374.quest_desc: [
		"Urga porte des lingots. Elle en veut plus. Toujours plus."
	]
	quest.4EB5D2C754679374.title: "Les lingots d'Urga"
	quest.510D385C84B27B4C.quest_desc: [
		"Scellé dans la salle du trésor d'une forteresse enfouie."
		""
		"Coche cette quête pour recevoir une &6carte au trésor&r. Elle mène à un donjon à environ 4000 blocs de la cabane. Prévoyez le voyage !"
	]
	quest.510D385C84B27B4C.title: "Indice : Forteresse Souterraine"
	quest.52C8F8B5C2EEFC5F.quest_desc: [
		"Seules les Sept Reliques peuvent ouvrir la Salle Zéro. Le Président les a fait cacher très loin, dans les pires donjons du monde."
		""
		"Suivez le chapitre &eLes Sept Reliques&r : réunissez-les toutes. Brokk en forgera une clé."
	]
	quest.52C8F8B5C2EEFC5F.quest_subtitle: "Acte IV — Aux quatre coins du monde"
	quest.52C8F8B5C2EEFC5F.title: "&eLes Sept Reliques"
	quest.52E14CF141DF0919.quest_desc: [
		"Les sept reliques sont de retour sur le comptoir."
		""
		"La Confrérie des Explorateurs renaît : vous êtes les nouveaux Gardiens de Beauvais."
	]
	quest.52E14CF141DF0919.quest_subtitle: "Les sept reliques sont réunies"
	quest.52E14CF141DF0919.title: "&6&lLe Réveil de la Cabane"
	quest.54BAB8678049D39C.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.54BAB8678049D39C.title: "L'Asile de la Peste"
	quest.54C6F739E6B19F28.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.54C6F739E6B19F28.title: "&cUmvuthi, roi de la savane"
	quest.54FAA7A9B44FD282.quest_desc: [
		"Ovsie veut refaire sa couronne de fleurs. Des coquelicots et des pissenlits, s'il te plaît !"
	]
	quest.54FAA7A9B44FD282.title: "La couronne d'Ovsie"
	quest.568AFD2416050B14.quest_desc: [
		"Votre avion a pris feu au-dessus de la jungle, mais vous avez sauté à temps. Vous voilà à Beauvais."
		""
		"Allez écouter &6Marcel le Conteur&r, au feu de camp : il vous racontera l'histoire du village (le chapitre &6L'Histoire de Beauvais&r commence là). Le &6Hejj du Village&r, devant la Grande Cabane, vous expliquera le reste. Puis cochez cette quête."
	]
	quest.568AFD2416050B14.quest_subtitle: "Le début de tout"
	quest.568AFD2416050B14.title: "Bienvenue à Beauvais"
	quest.575C2983B036C8A6.quest_desc: [
		"Le coffre du laboratoire contient un dossier, le carnet du Président et le rapport du Sujet 07. Tout y est : la potion verte, les Pillards payés, la Salle Zéro."
		""
		"Gardez le dossier : c'est la preuve. Et lisez le carnet…"
	]
	quest.575C2983B036C8A6.title: "Le dossier « Projet Augmenté »"
	quest.58089F70BF263FD2.quest_desc: [
		"Jacques a cassé son balai à force de balayer. Il lui faut de quoi en faire un neuf."
	]
	quest.58089F70BF263FD2.title: "Le balai de Jacques"
	quest.59A5D271A3B2BC7F.quest_desc: [
		"Un boss redoutable. Venez à plusieurs, avec vos meilleures armes."
	]
	quest.59A5D271A3B2BC7F.title: "&cFrostmaw"
	quest.59D736BF49BFCBA9.quest_desc: [
		"Un des grands donjons du monde. Trouve-le, entre, et ressors vivant."
	]
	quest.59D736BF49BFCBA9.title: "Les Tours Épineuses"
	quest.5A1FE7140641866E.quest_desc: [
		"Entre dans le donjon. Méfie-toi, ses gardiens ne t'attendent pas les bras ouverts."
	]
	quest.5A1FE7140641866E.title: "Trouver : Citadelles du Ciel"
	quest.5B29BBCFB6E40493.quest_desc: [
