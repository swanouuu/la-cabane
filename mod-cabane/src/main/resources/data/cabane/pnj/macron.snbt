  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Le Président",
        Texts:[{Text:"Mes chers compatriotes de Beauvais ! Bienvenue. Je suis votre Président. Et votre maire. Et, en même temps, un peu les deux."}],
        Buttons:[{
          Label:"gardes",
          Name:"Et vos gardes ?",
          Type:"ACTION",
          Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"gardes"}]
        },{
          Label:"travail",
          Name:"Du travail ?",
          Type:"ACTION",
          Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"travail"}]
        },{
          Label:"bye",
          Name:"Au revoir, Monsieur le Président",
          Type:"CLOSE"
        }]
      },{
        Label:"gardes",
        Name:"La garde",
        Texts:[{Text:"Ma garde rapprochée : quatre guerriers d'élite de la jungle. Je vous le dis avec bienveillance : ne me touchez pas. Ils finissent toujours par se calmer… mais pas tout de suite."}],
        Buttons:[{
          Label:"bye",
          Name:"Compris",
          Type:"CLOSE"
        }]
      },{
        Label:"travail",
        Name:"Le travail",
        Texts:[{Text:"Du travail ? Je traverse la place et je vous en trouve ! Mehdi, au Grand Bazar, affiche des contrats toutes les heures. C'est notre projet !"}],
        Buttons:[{
          Label:"bye",
          Name:"Merci, Monsieur le Président",
          Type:"CLOSE"
        }]
      }]
