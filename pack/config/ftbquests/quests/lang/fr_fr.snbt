	]
	quest.5B29BBCFB6E40493.title: "&cScylla"
	quest.5BC229FB0DEDF5E5.quest_desc: [
		"Mehdi, de Pôle emploi, affiche au Grand Bazar des contrats qui changent toutes les heures. Remplis-en un !"
	]
	quest.5BC229FB0DEDF5E5.title: "Premier contrat"
	quest.5D347F22EEDC08B3.quest_desc: [
		"Francis veut des tapis partout « pour étouffer les pas des gens de l'avion »."
	]
	quest.5D347F22EEDC08B3.title: "Pas de bruit après minuit"
	quest.5DFF817B33E4072A.quest_desc: [
		"Au fond du laboratoire, des cellules. Dans l'une d'elles, un homme qui parle encore : Pierre, « parti travailler à la capitale »."
		""
		"Écoutez ce qu'il sait, puis cochez."
	]
	quest.5DFF817B33E4072A.title: "Le Sujet 07"
	quest.61BC56987E3E4478.quest_desc: [
		"Vestige des fonderies et des citadelles mécaniques."
		""
		"Ramène-la à la Cabane et pose-la sur un cadre du &6mur des reliques&r."
	]
	quest.61BC56987E3E4478.title: "&6Engrenage Ancien"
	quest.62BD944D28455283.quest_desc: [
		"Beauvais vous accueille. Les habitants se méfient un peu des gens du ciel : à vous de faire vos preuves."
		""
		"Allez saluer les villageois, puis cochez cette quête."
	]
	quest.62BD944D28455283.title: "Le village qui nous héberge"
	quest.62EB8B71CE88A6BB.quest_desc: [
		"Avec Create, construisez une gare et une ligne de train qui part du village."
		"Livrez des rails pour la première voie, puis cochez la quête quand le premier train roule."
	]
	quest.62EB8B71CE88A6BB.title: "La gare de Beauvais"
	quest.630B39043A0588F3.quest_desc: [
		"64 bûches d'acacia pour réparer les maisons."
	]
	quest.630B39043A0588F3.title: "Du bois pour l'hiver"
	quest.6561CC20FB12373F.quest_desc: [
		"« Encore un de l'avion… » Jean aime le poisson grillé. Apporte-lui-en, ça l'adoucira peut-être."
	]
	quest.6561CC20FB12373F.title: "Jean se méfie"
	quest.66A15EBE9D8C3E3E.quest_desc: [
		"Ginette a peur du noir. Le Président aussi, mais il ne le dira pas."
		"Livrez des lanternes pour éclairer les nouvelles rues."
	]
	quest.66A15EBE9D8C3E3E.title: "Que la lumière soit"
	quest.675D84D08440B854.quest_desc: [
		"Elle repose dans un monument au fond de l'océan."
		""
		"Coche cette quête pour recevoir une &6carte au trésor&r. Elle mène à un donjon à environ 3500 blocs de la cabane. Prévoyez le voyage !"
	]
	quest.675D84D08440B854.title: "Indice : Monument des Profondeurs"
	quest.684BED4BD158F907.quest_desc: [
		"24 lingots de fer pour la forge du village."
	]
	quest.684BED4BD158F907.title: "Le forgeron a besoin de fer"
	quest.688714D5D7460A33.quest_desc: [
		"Les blessés des raids et des expéditions ont besoin de soins. Nyota veut des lits propres et de quoi préparer ses remèdes."
	]
	quest.688714D5D7460A33.title: "L'infirmerie de Nyota"
