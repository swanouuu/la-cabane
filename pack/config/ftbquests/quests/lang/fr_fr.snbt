	quest.7134CABD05CABA0E.quest_desc: [
		"Gribbs a besoin de « matière première » pour ses « œuvres d'art ». C'est de la terre cuite colorée."
	]
	quest.7134CABD05CABA0E.title: "Les cailloux peints de Gribbs"
	quest.71CB784E1E953B8D.quest_desc: [
		"Plus d'habitants, plus de bouches à nourrir. Livrez des récoltes pour les nouveaux greniers."
	]
	quest.71CB784E1E953B8D.title: "Les champs du village"
	quest.73A740F15D08ECBE.quest_desc: [
