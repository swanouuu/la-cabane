  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Le Fourgue",
        Texts:[{Text:"Psst. T'as pas vu de flics en venant ? … Bon. Qu'est-ce que tu veux ?"},{Text:"Je vends des graines. Pour le jardinage. Rien d'autre. Le jardinage."},{Text:"Tu ramènes la marchandise, je paye cash. Pas de questions, pas de reçu."},{Text:"La police de Beauvais me cherche depuis des mois. Ils cherchent mal."},{Text:"Un conseil d'ami : la descente, c'est pire que la montée. Mais bon, c'est pas mon problème."}],
        Buttons:[{
          Label:"acheter",
          Name:"Montre-moi ce que t'as",
          Type:"ACTION",
          Actions:[{Type:"COMMAND",Cmd:"cabane fourgue",ExecAsUser:1b,PermLevel:0},{Type:"CLOSE_DIALOG"}]
        },{
          Label:"vendre",
          Name:"J'ai de la marchandise",
          Type:"ACTION",
          Actions:[{Type:"COMMAND",Cmd:"cabane fourgue vendre",ExecAsUser:1b,PermLevel:0},{Type:"CLOSE_DIALOG"}]
        },{
          Label:"labo",
          Name:"Comment on cuisine ?",
          Type:"ACTION",
          Actions:[{Type:"OPEN_NAMED_DIALOG",Cmd:"labo"}]
        },{
          Label:"bye",
          Name:"J'ai rien vu",
          Type:"CLOSE"
        }]
      },{
        Label:"labo",
        Name:"Le Fourgue",
        Texts:[{Text:"Les graines, tu les plantes sur de la terre labourée, comme du blé. La weed donne des têtes, la coca des feuilles. Un joint, c'est une tête et du papier. Pour le reste, il te faut mon labo : 4 têtes donnent du hash, 6 feuilles et de la poudre à canon donnent de la coke, et la meth… redstone, sucre, poudre de blaze. Elle explose une fois sur cinq. Cuisine dehors."}],
        Buttons:[{
          Label:"bye",
          Name:"Compris",
          Type:"CLOSE"
        }]
      }]
  },
  Status:{finalized:1b}
