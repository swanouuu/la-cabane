  DialogData:{
    Type:"STANDARD",
    DialogDataSet:[{
        Label:"default",
        Name:"Ovsie",
        Texts:[{Text:"Coucou ! Tu collectionnes les cartes ? Les boosters se vendent chez Mouloud, et un classeur garde toute ta collection."},{Text:"Je brille la nuit. Le jour aussi, mais personne ne remarque."},{Text:"Si tu trouves une carte légendaire, je te fais un câlin. Un petit. Je suis petite."},{Text:"Le casino ? C'est mal. … Tu m'emmènes ?"}],
        Buttons:[{
